<?xml version="1.0" encoding="UTF-8"?>
<!-- Forum browser: replaces the message view when a forum channel is opened. -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.7"/>
  <!-- Packed into the chat page's shared header bar by code. -->
  <object class="GtkToggleButton" id="searchButton">
    <property name="icon-name">system-search-symbolic</property>
    <property name="tooltip-text">Search</property>
  </object>
  <object class="AdwToolbarView" id="rootContent">
    <property name="top-bar-style">raised</property>
    <child type="top">
      <!-- Hidden until the search button is toggled. -->
      <object class="GtkRevealer" id="filterRevealer">
        <property name="reveal-child" bind-source="searchButton" bind-property="active" bind-flags="sync-create"/>
        <property name="child">
          <object class="GtkBox" id="filterBar">
            <property name="orientation">vertical</property>
            <property name="spacing">8</property>
            <style>
              <class name="forum-filter-bar"/>
            </style>
            <child>
              <object class="GtkBox">
                <property name="spacing">6</property>
                <child>
                  <object class="GtkSearchEntry" id="searchEntry">
                    <property name="hexpand">true</property>
                    <property name="placeholder-text">Search posts</property>
                  </object>
                </child>
                <child>
                  <object class="GtkDropDown" id="sortDropDown">
                    <property name="tooltip-text">Sort by</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item>Recent Activity</item>
                          <item>Date Posted</item>
                        </items>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <!-- Tag filter pills, filled in by code. -->
              <object class="AdwWrapBox" id="tagsBox">
                <property name="child-spacing">6</property>
                <property name="line-spacing">6</property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
    <property name="content">
      <object class="GtkStack" id="contentStack">
        <property name="transition-type">crossfade</property>
        <child>
          <object class="GtkStackPage">
            <property name="name">loading</property>
            <property name="child">
              <object class="AdwSpinner">
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="width-request">32</property>
                <property name="height-request">32</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">posts</property>
            <property name="child">
              <object class="GtkScrolledWindow" id="postScroll">
                <property name="hscrollbar-policy">never</property>
                <property name="vexpand">true</property>
                <property name="child">
                  <object class="AdwClamp">
                    <property name="maximum-size">860</property>
                    <property name="tightening-threshold">600</property>
                    <property name="child">
                      <!-- Post cards (forum_post.ui), filled in by code. -->
                      <object class="GtkListBox" id="postList">
                        <property name="selection-mode">none</property>
                        <property name="valign">start</property>
                        <style>
                          <class name="boxed-list-separate"/>
                          <class name="forum-post-list"/>
                        </style>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">empty</property>
            <property name="child">
              <object class="AdwStatusPage" id="emptyPage">
                <property name="icon-name">system-search-symbolic</property>
                <property name="title">No Posts Found</property>
                <property name="description">Try a different search or tag</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">error</property>
            <property name="child">
              <object class="AdwStatusPage" id="errorPage">
                <property name="icon-name">dialog-error-symbolic</property>
                <property name="title">Cannot Load Posts</property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
