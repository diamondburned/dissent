<?xml version="1.0" encoding="UTF-8"?>
<!-- Content of the message summaries popover. -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkBox" id="rootContent">
    <property name="orientation">vertical</property>
    <property name="width-request">360</property>
    <style>
      <class name="message-summaries"/>
    </style>
    <child>
      <object class="GtkLabel">
        <property name="label">Conversation Summaries</property>
        <property name="xalign">0</property>
        <style>
          <class name="heading"/>
          <class name="message-summaries-heading"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow">
        <property name="hscrollbar-policy">never</property>
        <property name="propagate-natural-height">true</property>
        <property name="max-content-height">500</property>
        <property name="child">
          <!-- Rows (summary_row.ui), filled in by code. -->
          <object class="GtkListBox" id="list">
            <property name="selection-mode">none</property>
            <style>
              <class name="boxed-list"/>
              <class name="message-summaries-list"/>
            </style>
          </object>
        </property>
      </object>
    </child>
  </object>
</interface>
