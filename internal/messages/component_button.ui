<?xml version="1.0" encoding="UTF-8"?>
<!-- A button component. Its style classes are added in code. -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkButton" id="rootContent">
    <style>
      <class name="message-component-button"/>
    </style>
    <child>
      <object class="GtkStack" id="stack">
        <property name="hhomogeneous">false</property>
        <property name="transition-type">crossfade</property>
        <child>
          <object class="GtkStackPage">
            <property name="name">content</property>
            <property name="child">
              <object class="GtkBox">
                <property name="spacing">6</property>
                <property name="halign">center</property>
                <child>
                  <object class="GtkBox" id="emoji"/>
                </child>
                <child>
                  <object class="GtkLabel" id="label">
                    <property name="ellipsize">end</property>
                  </object>
                </child>
                <child>
                  <object class="GtkImage" id="link">
                    <property name="icon-name">adw-external-link-symbolic</property>
                    <property name="visible">false</property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">busy</property>
            <property name="child">
              <object class="AdwSpinner"/>
            </property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
