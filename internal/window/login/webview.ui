<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.6"/>
  <object class="AdwNavigationPage" id="rootContent">
    <property name="title" translatable="yes">Log in with Discord</property>
    <property name="tag">browser</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle" id="windowTitle">
                <property name="title" translatable="yes">Log in with Discord</property>
              </object>
            </property>
          </object>
        </child>
        <property name="content">
          <object class="GtkOverlay" id="webOverlay">
            <child type="overlay">
              <object class="GtkProgressBar" id="progressBar">
                <property name="valign">start</property>
                <property name="visible">false</property>
                <style>
                  <class name="osd"/>
                </style>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
